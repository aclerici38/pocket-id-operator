{{- /* A table of .type's fields, then a section for each field that is a local struct. */ -}}
{{- define "fields" -}}
{{- $path := .path }}{{ $pkg := .pkg }}{{ $fields := list }}
{{- range .type.Members }}
  {{- /* Unwrap pointers (Kind 4), slices (5) and maps (3) down to the element type. */ -}}
  {{- $t := .Type }}{{ $suffix := "" }}
  {{- if eq $t.Kind 4 }}{{ $t = $t.UnderlyingType }}{{ end }}
  {{- if eq $t.Kind 5 }}{{ $suffix = "[]" }}{{ $t = $t.UnderlyingType }}{{ end }}
  {{- if eq $t.Kind 3 }}{{ $suffix = "[key]" }}{{ $t = $t.ValueType }}{{ end }}
  {{- $child := "" }}
  {{- if and (eq $t.Kind 6) (eq $t.Package $pkg) $t.Members }}{{ $child = printf "%s.%s%s" $path .Name $suffix }}{{ end }}
  {{- $fields = append $fields (dict "field" . "type" $t "suffix" $suffix "child" $child) }}
{{- end -}}

| Field | Type | Required | Default | Description |
| --- | --- | --- | --- | --- |
{{- with .gv }}
| `apiVersion` | string | yes | | `{{ . }}` |
| `kind` | string | yes | | `{{ $path }}` |
{{- end }}
{{- range $fields }}
| {{ template "name" . }} | {{ template "type" . }} | {{ template "required" .field }} | {{ template "default" .field }} | {{ template "description" .field }} |
{{- end }}
{{ range $fields }}{{ if .child }}
{{ template "section" (dict "path" .child "parent" $path "type" .type "pkg" $pkg) }}
{{- end }}{{ end }}
{{- end -}}

{{- define "anchor" -}}
{{ . | lower | replace "[]" "" | replace "[key]" "" | replace "." "-" }}
{{- end -}}

{{- define "name" -}}
{{ if .child }}[`{{ .field.Name }}`](#{{ template "anchor" .child }}){{ else }}`{{ .field.Name }}`{{ end }}
{{- end -}}

{{- define "type" -}}
{{ if .child }}{{ get (dict "" "object" "[]" "[]object" "[key]" "map[string]object") .suffix }}{{ else }}{{ markdownRenderType .field.Type }}{{ end }}
{{- end -}}

{{- define "required" -}}
{{ if not (or (index .Markers "optional") (index .Markers "kubebuilder:validation:Optional")) }}yes{{ end }}
{{- end -}}

{{- define "default" -}}
{{ with .Default }}`{{ markdownRenderDefault . }}`{{ end }}
{{- end -}}

{{- define "description" -}}
{{ markdownRenderFieldDoc .Doc }}{{ range without .Validation "Optional: {}" "Required: {}" }}<br />_{{ markdownRenderFieldDoc . }}_{{ end }}
{{- end -}}
